{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'invoices' %}
{% import "macro_functions.html.twig" as mf %}

{% set nr = invoice.serie ~ "%05s"|format(invoice.nr) %}

{% block meta_title %}{{ 'Invoice'|trans }} #{{ nr }}{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ ''|url }}">{{ 'Dashboard'|trans }}</a></li>
    <li class="breadcrumb-item"><a href="{{ 'invoice'|url }}">{{ 'Invoices'|trans }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">#{{ nr }}</li>
{% endblock %}

{% block content %}
{% set seller = invoice.seller %}
{% set buyer = invoice.buyer %}
{% set company = guest.system_company %}

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold mb-0">{{ 'Invoice'|trans }} #{{ nr }}</h1>
                {{ mf.status_badge(invoice.status, 'invoice') }}
            </div>
            <p class="text-muted small mb-0">{{ 'Created on %s'|trans|format(invoice.created_at|format_date) }}</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ ('invoice/pdf/' ~ invoice.hash)|url }}" target="_blank" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                    <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" />
                    <line x1="9" y1="9" x2="10" y2="9" />
                    <line x1="9" y1="13" x2="15" y2="13" />
                    <line x1="9" y1="17" x2="15" y2="17" />
                </svg>
                <span>{{ 'Download PDF'|trans }}</span>
            </a>
            <a href="{{ ('invoice/print/' ~ invoice.hash)|url }}" target="_blank" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M17 17h2a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2h-14a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h2" />
                    <path d="M17 9v-4a2 2 0 0 0 -2 -2h-6a2 2 0 0 0 -2 2v4" />
                    <rect x="7" y="13" width="10" height="8" rx="2" />
                </svg>
                <span>{{ 'Print'|trans }}</span>
            </a>
        </div>
    </div>

    {% if invoice.status == 'unpaid' %}
        <div class="card theme-card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent border-bottom p-3">
                <h3 class="card-title h5 mb-0">{{ 'Payment Methods'|trans }}</h3>
            </div>
            <div class="card-body p-3">
                <p class="text-muted small mb-3">{{ 'Select your preferred payment gateway to settle this invoice.'|trans }}</p>
                <div class="d-flex flex-wrap gap-3">
                    {% for gtw in guest.invoice_gateways %}
                        {% if invoice.currency in gtw.accepted_currencies and (gtw.allow_single or (invoice.subscribable and gtw.allow_recurrent)) %}
                            <div class="p-2 border rounded-3 bg-surface hover-shadow cursor-pointer text-center" style="min-width: 140px;"
                                 onclick="paymentPrompt('{{ gtw.id }}', {{ gtw.allow_recurrent ? 'true' : 'false' }}, {{ gtw.allow_single ? 'true' : 'false' }}, `{{ gtw.title }}`)">
                                {% if gtw.logo.logo %}
                                    <img src="{{ gtw.logo.logo }}" alt="{{ gtw.title }}" style="max-height: 40px; max-width: 120px;" class="mb-1" />
                                {% else %}
                                    <div class="fw-semibold py-2">{{ gtw.title }}</div>
                                {% endif %}
                                <div class="small text-muted">{{ gtw.title }}</div>
                            </div>
                        {% endif %}
                    {% else %}
                        <p class="text-muted small mb-0">{{ 'No payment gateways currently available.'|trans }}</p>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}

    <div class="card theme-card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="row g-4 mb-4">
                <div class="col-sm-6">
                    <span class="text-uppercase text-muted fs-8 fw-bold">{{ 'Payable To'|trans }}</span>
                    <h4 class="fw-bold mt-1 mb-1">{{ seller.company|default(company.name) }}</h4>
                    <div class="text-muted small">
                        {% if seller.address %}{{ seller.address }}<br>{% endif %}
                        {% if seller.company_vat %}{{ 'VAT'|trans }}: {{ seller.company_vat }}<br>{% endif %}
                        {% if seller.phone %}{{ 'Phone'|trans }}: {{ seller.phone }}<br>{% endif %}
                        {% if seller.email %}{{ seller.email }}{% endif %}
                    </div>
                </div>
                <div class="col-sm-6 text-sm-end">
                    <span class="text-uppercase text-muted fs-8 fw-bold">{{ 'Billed To'|trans }}</span>
                    <h4 class="fw-bold mt-1 mb-1">{{ buyer.first_name }} {{ buyer.last_name }}</h4>
                    <div class="text-muted small">
                        {% if buyer.company %}{{ buyer.company }}<br>{% endif %}
                        {% if buyer.address %}{{ buyer.address }}<br>{% endif %}
                        {% if buyer.city or buyer.country %}{{ buyer.city }}{% if buyer.city and buyer.country %}, {% endif %}{{ buyer.country }}<br>{% endif %}
                        {{ buyer.email }}
                    </div>
                </div>
            </div>

            <div class="row g-3 py-3 border-top border-bottom mb-4">
                <div class="col-6 col-md-3">
                    <span class="text-muted small d-block">{{ 'Invoice Date'|trans }}</span>
                    <span class="fw-semibold">{{ invoice.created_at|format_date }}</span>
                </div>
                <div class="col-6 col-md-3">
                    <span class="text-muted small d-block">{{ 'Due Date'|trans }}</span>
                    <span class="fw-semibold text-danger">{{ invoice.due_at ? invoice.due_at|format_date : '-' }}</span>
                </div>
                <div class="col-6 col-md-3">
                    <span class="text-muted small d-block">{{ 'Status'|trans }}</span>
                    <span>{{ mf.status_badge(invoice.status, 'invoice') }}</span>
                </div>
                <div class="col-6 col-md-3 text-md-end">
                    <span class="text-muted small d-block">{{ 'Total Due'|trans }}</span>
                    <span class="h4 fw-bold mb-0 text-primary">{{ invoice.total|format_currency(invoice.currency ?? default_currency) }}</span>
                </div>
            </div>

            <div class="table-responsive mb-4">
                <table class="table table-vcenter">
                    <thead class="table-light">
                        <tr>
                            <th>{{ 'Description'|trans }}</th>
                            <th class="text-center" style="width: 100px;">{{ 'Qty'|trans }}</th>
                            <th class="text-end" style="width: 140px;">{{ 'Unit Price'|trans }}</th>
                            <th class="text-end" style="width: 140px;">{{ 'Total'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for item in invoice.lines %}
                        <tr>
                            <td>
                                <div class="fw-medium">
                                    {% if item.order_id %}
                                        <a href="{{ ('order/service/manage/' ~ item.order_id)|url }}">{{ item.title }}</a>
                                    {% else %}
                                        {{ item.title }}
                                    {% endif %}
                                </div>
                            </td>
                            <td class="text-center text-muted">{{ item.quantity }}</td>
                            <td class="text-end text-muted">{{ item.price|format_currency(invoice.currency ?? default_currency) }}</td>
                            <td class="text-end fw-semibold">{{ item.total|format_currency(invoice.currency ?? default_currency) }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="row justify-content-end">
                <div class="col-md-5">
                    <table class="table table-borderless table-sm">
                        {% if invoice.tax > 0 %}
                            <tr>
                                <td class="text-muted">{{ invoice.taxname }} ({{ invoice.taxrate }}%)</td>
                                <td class="text-end fw-medium">{{ invoice.tax|format_currency(invoice.currency ?? default_currency) }}</td>
                            </tr>
                        {% endif %}
                        {% if invoice.discount|default(0) > 0 %}
                            <tr>
                                <td class="text-muted">{{ 'Discount'|trans }}</td>
                                <td class="text-end text-success fw-medium">-{{ invoice.discount|format_currency(invoice.currency ?? default_currency) }}</td>
                            </tr>
                        {% endif %}
                        <tr class="border-top">
                            <td class="h5 fw-bold pt-3">{{ 'Total'|trans }}</td>
                            <td class="h5 fw-bold text-end pt-3 text-primary">{{ invoice.total|format_currency(invoice.currency ?? default_currency) }}</td>
                        </tr>
                    </table>
                </div>
            </div>

            {% if invoice.text_2 %}
                <div class="p-3 bg-surface border rounded-3 mt-4">
                    <div class="small text-muted mb-1 fw-bold">{{ 'Notes & Terms'|trans }}</div>
                    <div class="small">{{ invoice.text_2|markdown_to_html }}</div>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Payment Prompt Modal -->
    <div class="modal fade" id="paymentPrompt" tabindex="-1" aria-labelledby="paymentPromptLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="paymentPromptLabel"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                </div>
                <div class="modal-body">
                    <p id="bodyText" class="text-muted mb-4"></p>
                    <div class="d-grid gap-2">
                        <a href="#" class="btn btn-primary" id="single">{{ "Pay Now (One-Time)"|trans }}</a>
                        <a href="#" class="btn btn-outline-primary" id="subscription" hidden>{{ "Pay & Create Subscription"|trans }}</a>
                        <a href="#" class="btn btn-primary" id="pay-nondescript" hidden>{{ "Proceed to Payment"|trans }}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block js %}
<script>
    function paymentPrompt(id, supportsSubscription, supportsOneTime, title) {
        const invoiceHash = "{{ invoice.hash }}";
        const backLink = "{{ 'invoice/banklink'|url }}";
        const paymentLink = new URL(backLink.concat('/', invoiceHash, '/', id));
        const invoiceSubscribable = {{ invoice.subscribable ? 'true' : 'false' }};

        const singleBtn = document.getElementById('single');
        const subscriptionBtn = document.getElementById('subscription');
        const genericBtn = document.getElementById('pay-nondescript');
        singleBtn.hidden = true;
        subscriptionBtn.hidden = true;
        genericBtn.hidden = true;

        if (supportsSubscription && supportsOneTime && invoiceSubscribable) {
            document.getElementById('bodyText').textContent = `{{ 'This invoice and chosen gateway support subscription payments. How would you like to continue?'|trans }}`;
            subscriptionBtn.hidden = false;
            singleBtn.hidden = false;
        } else if (supportsSubscription && invoiceSubscribable) {
            document.getElementById('bodyText').textContent = `{{ 'This payment gateway will establish a recurring subscription for this service.'|trans }}`;
            subscriptionBtn.hidden = false;
        } else if (supportsOneTime) {
            document.getElementById('bodyText').textContent = `{{ 'You will be redirected to the secure payment processor to complete this transaction.'|trans }}`;
            singleBtn.hidden = false;
        } else {
            document.getElementById('bodyText').textContent = `{{ 'Proceed to complete your payment securely.'|trans }}`;
            genericBtn.hidden = false;
        }

        document.getElementById('paymentPromptLabel').textContent = `{{ 'Pay with'|trans }} ` + title;
        subscriptionBtn.href = paymentLink.toString();
        genericBtn.href = paymentLink.toString();

        const singlePaymentLink = new URL(paymentLink);
        singlePaymentLink.searchParams.append('allow_subscription', '0');
        singleBtn.href = singlePaymentLink.toString();

        const modal = new bootstrap.Modal(document.getElementById('paymentPrompt'));
        modal.show();
    }
</script>
{% endblock %}
