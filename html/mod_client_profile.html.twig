{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'profile' %}

{% block meta_title %}{{ 'Profile Settings'|trans }}{% endblock %}

{% set required = guest.client_required %}

{% block content %}
<div class="theme-page-header">
    <div>
        <h1 class="theme-page-title">{{ 'Profile & Security'|trans }}</h1>
        <p class="text-muted mb-0">{{ 'Manage your personal details, password, and account settings.'|trans }}</p>
    </div>
</div>

{% if (guest.client_is_email_validation_required) and (not profile.email_approved) %}
    <div class="theme-alert theme-alert-danger mb-4" role="alert">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <div class="flex-1">
            <span>{{ 'You must verify your email address before you may access all portal features.'|trans }}</span>
            <div class="mt-2">
                <a class="theme-btn theme-btn-primary theme-btn-sm" href="{{ 'client/resend_email_verification'|api_url }}"
                   {{ fb_api_link({message: 'Verification Email Re-sent'|trans}) }}>
                   {{ 'Resend Verification Email'|trans }}
                </a>
            </div>
        </div>
    </div>
{% endif %}

<div class="theme-card">
    <div class="theme-card-header" style="border-bottom: 1px solid var(--border-subtle); padding: 0.75rem 1.25rem;">
        <div class="d-flex gap-2 overflow-x-auto pb-1" id="profile-tabs" role="tablist" style="-webkit-overflow-scrolling: touch;">
            <button type="button" class="theme-btn theme-btn-primary theme-btn-sm profile-tab-btn active text-nowrap" data-tab="details">
                {{ 'Personal Details'|trans }}
            </button>
            <button type="button" class="theme-btn theme-btn-secondary theme-btn-sm profile-tab-btn text-nowrap" data-tab="password">
                {{ 'Change Password'|trans }}
            </button>
            <button type="button" class="theme-btn theme-btn-secondary theme-btn-sm profile-tab-btn text-nowrap" data-tab="currency">
                {{ 'Currency'|trans }}
            </button>
            <button type="button" class="theme-btn theme-btn-secondary theme-btn-sm profile-tab-btn text-nowrap" data-tab="apikey">
                {{ 'API Key'|trans }}
            </button>
        </div>
    </div>

    <!-- Personal Details Tab -->
    <div id="tab-details" class="theme-card-body profile-tab-pane">
        <form method="post" action="{{ 'client/profile/update'|api_url }}" id="profile-update" {{ fb_api_form({message: 'Profile Updated'|trans}) }}>
            <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">
            <div class="d-flex align-items-center gap-3 mb-4 p-3 rounded" style="background: var(--bg-subtle);">
                <div class="theme-avatar" style="width: 54px; height: 54px; font-size: 1.25rem;">
                    {{ profile.first_name|first|upper }}{{ profile.last_name|first|upper }}
                </div>
                <div>
                    <div style="font-weight: 700; font-size: 1.1rem;">{{ profile.first_name }} {{ profile.last_name }}</div>
                    <div style="font-size: 0.8125rem; color: var(--text-muted);">{{ profile.email }}</div>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
                <div class="theme-form-group">
                    <label class="theme-form-label" for="first_name">{{ 'First Name'|trans }} *</label>
                    <input type="text" class="theme-input" name="first_name" id="first_name" value="{{ profile.first_name }}" required>
                </div>
                <div class="theme-form-group">
                    <label class="theme-form-label" for="last_name">{{ 'Last Name'|trans }} {% if "last_name" in required %}*{% endif %}</label>
                    <input type="text" class="theme-input" name="last_name" id="last_name" value="{{ profile.last_name }}" {% if "last_name" in required %}required{% endif %}>
                </div>
                <div class="theme-form-group">
                    <label class="theme-form-label" for="company">{{ 'Company Name'|trans }} {% if "company" in required %}*{% endif %}</label>
                    <input type="text" class="theme-input" name="company" id="company" value="{{ profile.company }}" {% if "company" in required %}required{% endif %}>
                </div>
                <div class="theme-form-group">
                    <label class="theme-form-label" for="phone">{{ 'Phone Number'|trans }} {% if "phone" in required %}*{% endif %}</label>
                    <div style="display: flex; gap: 0.5rem;">
                        <input type="text" class="theme-input" style="width: 80px;" name="phone_cc" value="{{ profile.phone_cc }}" placeholder="+1" aria-label="{{ 'Country code'|trans }}">
                        <input type="text" class="theme-input" style="flex: 1;" name="phone" id="phone" value="{{ profile.phone }}" {% if "phone" in required %}required{% endif %} aria-label="{{ 'Phone number'|trans }}">
                    </div>
                </div>
                <div class="theme-form-group" style="grid-column: 1 / -1;">
                    <label class="theme-form-label" for="address_1">{{ 'Address'|trans }} {% if "address_1" in required %}*{% endif %}</label>
                    <input type="text" class="theme-input" name="address_1" id="address_1" value="{{ profile.address_1 }}" {% if "address_1" in required %}required{% endif %}>
                </div>
                <div class="theme-form-group">
                    <label class="theme-form-label" for="city">{{ 'City'|trans }} {% if "city" in required %}*{% endif %}</label>
                    <input type="text" class="theme-input" name="city" id="city" value="{{ profile.city }}" {% if "city" in required %}required{% endif %}>
                </div>
                <div class="theme-form-group">
                    <label class="theme-form-label" for="country">{{ 'Country'|trans }} {% if "country" in required %}*{% endif %}</label>
                    <select class="theme-select" name="country" id="country" {% if "country" in required %}required{% endif %}>
                        <option value="">{{ '-- Select Country --'|trans }}</option>
                        {% for val,label in guest.system_countries %}
                            <option value="{{ val }}" {% if val == profile.country %}selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="theme-form-group">
                    <label class="theme-form-label" for="postcode">{{ 'Postal Code'|trans }} {% if "postcode" in required %}*{% endif %}</label>
                    <input type="text" class="theme-input" name="postcode" id="postcode" value="{{ profile.postcode }}" {% if "postcode" in required %}required{% endif %}>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top border-subtle">
                <button type="submit" class="theme-btn theme-btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    <span>{{ 'Save Changes'|trans }}</span>
                </button>
            </div>
        </form>
    </div>

    <!-- Password Tab -->
    <div id="tab-password" class="theme-card-body profile-tab-pane d-none">
        <h3 class="theme-card-title mb-2">{{ 'Change Password'|trans }}</h3>
        <p class="text-muted mb-4">{{ 'Ensure your account stays secure by using a strong password.'|trans }}</p>

        <form method="post" action="{{ 'client/profile/change_password'|api_url }}" {{ fb_api_form({message: 'Password Updated Successfully'|trans}) }} style="max-width: 480px;">
            <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">
            <div class="theme-form-group">
                <label class="theme-form-label" for="current_password">{{ 'Current Password'|trans }}</label>
                <input type="password" class="theme-input" name="current_password" id="current_password" required>
            </div>
            <div class="theme-form-group">
                <label class="theme-form-label" for="new_password">{{ 'New Password'|trans }}</label>
                <input type="password" class="theme-input" name="new_password" id="new_password" required minlength="8">
                <div class="form-text text-muted" style="font-size: 0.75rem;">{{ 'Minimum 8 characters with at least one letter and one number.'|trans }}</div>
            </div>
            <div class="theme-form-group">
                <label class="theme-form-label" for="password_confirm">{{ 'Confirm New Password'|trans }}</label>
                <input type="password" class="theme-input" name="password_confirm" id="password_confirm" required minlength="8">
            </div>

            <div class="mt-4 pt-3 border-top border-subtle">
                <button type="submit" class="theme-btn theme-btn-primary">
                    <span>{{ 'Update Password'|trans }}</span>
                </button>
            </div>
        </form>
    </div>

    <!-- Currency Tab -->
    <div id="tab-currency" class="theme-card-body profile-tab-pane d-none">
        <h3 class="theme-card-title mb-2">{{ 'Billing Currency'|trans }}</h3>
        <p class="text-muted mb-4">{{ 'Choose your preferred currency for invoices and orders.'|trans }}</p>

        <form method="post" action="{{ 'client/profile/currency_update'|api_url }}" {{ fb_api_form({message: 'Currency Updated'|trans, reload: true}) }} style="max-width: 480px;">
            <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">
            <div class="theme-form-group">
                <label class="theme-form-label" for="currency">{{ 'Selected Currency'|trans }}</label>
                <select name="currency" id="currency" class="theme-select">
                    {% for cur in guest.currency_get_pairs %}
                        <option value="{{ cur.code }}" {% if cur.code == profile.currency %}selected{% endif %}>{{ cur.code }} - {{ cur.title }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="mt-4 pt-3 border-top border-subtle">
                <button type="submit" class="theme-btn theme-btn-primary">
                    <span>{{ 'Update Currency'|trans }}</span>
                </button>
            </div>
        </form>
    </div>

    <!-- API Key Tab -->
    <div id="tab-apikey" class="theme-card-body profile-tab-pane d-none">
        <h3 class="theme-card-title mb-2">{{ 'API Key Management'|trans }}</h3>
        <p class="text-muted mb-4">{{ 'Your API key allows programmatic access to your account services.'|trans }}</p>

        <div class="p-3 rounded mb-3" style="background: var(--bg-subtle);">
            <label class="theme-form-label" for="api_key_field">{{ 'Your API Key'|trans }}</label>
            <input type="text" class="theme-input font-monospace" id="api_key_field" value="{{ profile.api_key }}" readonly>
        </div>

        <a href="{{ 'client/profile/api_key_reset'|api_url }}" class="theme-btn theme-btn-secondary"
           {{ fb_api_link({
               modal: { type: 'confirm', title: 'Reset API Key?'|trans },
               reload: true,
               message: 'API Key Regenerated'|trans
           }) }}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><polyline points="23 20 23 14 17 14"/><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/></svg>
            <span>{{ 'Generate New API Key'|trans }}</span>
        </a>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const tabBtns = document.querySelectorAll('.profile-tab-btn');
    const panes = document.querySelectorAll('.profile-tab-pane');

    tabBtns.forEach(btn => {
        btn.addEventListener('click', function () {
            const target = this.getAttribute('data-tab');
            tabBtns.forEach(b => {
                b.classList.remove('theme-btn-primary', 'active');
                b.classList.add('theme-btn-secondary');
            });
            this.classList.remove('theme-btn-secondary');
            this.classList.add('theme-btn-primary', 'active');

            panes.forEach(p => p.classList.add('d-none'));
            const activePane = document.getElementById('tab-' + target);
            if (activePane) activePane.classList.remove('d-none');
        });
    });
});
</script>
{% endblock %}
