{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'support' %}
{% import "macro_functions.html.twig" as mf %}
{% set is_guest_ticket = ticket.author.role|default('') == 'guest' %}
{% set can_reply = ticket.status != 'closed' or (not is_guest_ticket and ticket.helpdesk.can_reopen) %}

{% block meta_title %}{{ ticket.subject }}{% endblock %}

{% block head %}
    {{ 'css/markdown.css'|public_asset_url|stylesheet_tag }}
    {{ wysiwyg('.editor-textarea') }}
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ ''|url }}">{{ 'Dashboard'|trans }}</a></li>
    {% if is_guest_ticket %}
        <li class="breadcrumb-item"><a href="{{ 'support/contact-us'|url }}">{{ 'Contact Us'|trans }}</a></li>
    {% else %}
        <li class="breadcrumb-item"><a href="{{ 'support'|url }}">{{ 'Support Tickets'|trans }}</a></li>
    {% endif %}
    <li class="breadcrumb-item active" aria-current="page">#{{ ticket.id }}</li>
{% endblock %}

{% block content %}
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold mb-0">{{ ticket.subject }}</h1>
                {{ mf.status_badge(ticket.status, 'ticket') }}
            </div>
            <p class="text-muted small mb-0">{{ 'Ticket #%s &bull; Department: %s &bull; Opened %s'|trans|format(ticket.id, ticket.helpdesk.name, ticket.created_at|format_date) }}</p>
        </div>
        <div class="d-flex gap-2">
            {% if can_reply %}
                <a href="#reply-to" class="btn btn-primary d-flex align-items-center gap-2" id="reply-to-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M12 20h-7a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v3.5" />
                        <path d="M16 19h6" />
                        <path d="M19 16l3 3l-3 3" />
                    </svg>
                    <span>{{ 'Reply'|trans }}</span>
                </a>
            {% endif %}
            {% if ticket.status != 'closed' %}
                <button type="button" class="btn btn-outline-danger d-flex align-items-center gap-2" id="ticket-close">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                    <span>{{ 'Close Ticket'|trans }}</span>
                </button>
            {% endif %}
        </div>
    </div>

    <!-- Related Service alert if applicable -->
    {% if ticket.rel_type|default('') == 'order' and ticket.rel_id %}
        <div class="alert alert-info d-flex align-items-center gap-2 mb-4" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="20" height="20" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <line x1="12" y1="8" x2="12.01" y2="8" />
                <polyline points="11 12 12 12 12 16 13 16" />
            </svg>
            <div>
                {{ 'This inquiry is related to service'|trans }} 
                <a href="{{ ('order/service/manage/' ~ ticket.rel_id)|url }}" class="alert-link fw-semibold">#{{ ticket.rel_id }}</a>
            </div>
        </div>
    {% endif %}

    <!-- Conversation Messages Stream -->
    <div class="d-flex flex-column gap-3 mb-4">
        {% for message in ticket.messages %}
            {% set is_admin = message.author.role|default('') == 'admin' %}
            <div class="card theme-card border-0 shadow-sm {% if is_admin %}border-start border-primary border-4{% endif %}" id="msg-{{ message.id }}">
                <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar avatar-md rounded-circle bg-surface border text-uppercase fw-bold d-flex align-items-center justify-content-center text-primary" style="width: 38px; height: 38px;">
                            {{ message.author.name|slice(0, 1) }}
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-semibold">{{ message.author.name }}</span>
                                {% if is_admin %}
                                    <span class="badge bg-primary-lt text-primary small">{{ 'Staff Specialist'|trans }}</span>
                                {% else %}
                                    <span class="badge bg-secondary-lt text-secondary small">{{ 'You'|trans }}</span>
                                {% endif %}
                            </div>
                            <span class="text-muted fs-8">{{ message.created_at|format_date }} &bull; {{ message.created_at|timeago ~ ' ' ~ 'ago'|trans }}</span>
                        </div>
                    </div>
                    {% if can_reply %}
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-quote-reply d-flex align-items-center gap-1"
                                message-quote="{{ mf.markdown_quote(message.content) }}"
                                title="{{ 'Quote Reply'|trans }}">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="16" height="16" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M10 11h-4a1 1 0 0 1 -1 -1v-3a1 1 0 0 1 1 -1h3a1 1 0 0 1 1 1v6c0 2.667 -1.333 4.333 -4 5" />
                                <path d="M19 11h-4a1 1 0 0 1 -1 -1v-3a1 1 0 0 1 1 -1h3a1 1 0 0 1 1 1v6c0 2.667 -1.333 4.333 -4 5" />
                            </svg>
                            <span class="d-none d-sm-inline">{{ 'Quote'|trans }}</span>
                        </button>
                    {% endif %}
                </div>
                <div class="card-body p-4">
                    <article class="markdown-body bg-transparent text-reset">
                        {{ (message.content ?? '')|markdown_to_html }}
                    </article>
                </div>
            </div>
        {% endfor %}
    </div>

    <!-- Reply Box -->
    <div id="reply-to">
        {% if not can_reply %}
            <div class="card theme-card border-0 shadow-sm p-4 text-center">
                <p class="text-muted mb-0">{{ 'This ticket is closed and cannot receive additional replies.'|trans }}</p>
            </div>
        {% else %}
            {% if ticket.status == 'closed' %}
                <div class="alert alert-warning mb-3">
                    {{ 'This ticket is currently closed, but submitting a response will automatically reopen it.'|trans }}
                </div>
            {% endif %}

            <div class="card theme-card border-0 shadow-sm">
                <div class="card-header bg-transparent border-bottom p-3">
                    <h4 class="card-title h5 mb-0 fw-bold">{{ 'Post a Reply'|trans }}</h4>
                </div>
                <div class="card-body p-4">
                    <form id="ticket-reply-form">
                        <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">
                        {% if is_guest_ticket %}
                            <input type="hidden" name="hash" value="{{ ticket.hash }}">
                        {% else %}
                            <input type="hidden" name="id" value="{{ ticket.id }}">
                        {% endif %}

                        <div class="mb-3">
                            <textarea name="content" rows="6" class="editor-textarea form-control" required id="ticket-reply-text" placeholder="{{ 'Write your response here...'|trans }}"></textarea>
                        </div>

                        {{ mf.recaptcha }}

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary d-flex align-items-center gap-2" id="post-reply-btn">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="10" y1="14" x2="21" y2="3" />
                                    <path d="M21 3l-6.5 18a0.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a0.55 .55 0 0 1 0 -1l18 -6.5" />
                                </svg>
                                <span>{{ 'Submit Response'|trans }}</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block js %}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const ticketReplyForm = document.getElementById('ticket-reply-form');
        const closeTicketBtn = document.getElementById('ticket-close');
        const postReplyBtn = document.getElementById('post-reply-btn');
        const replyToMessageBtns = document.querySelectorAll('.btn-quote-reply');
        const ticketReplyTextArea = document.getElementById('ticket-reply-text');
        const supportApi = FOSSBilling.api.{{ is_guest_ticket ? 'guest' : 'client' }};

        ticketReplyForm?.addEventListener('submit', (e) => {
            e.preventDefault();
            if (postReplyBtn) {
                postReplyBtn.disabled = true;
                postReplyBtn.textContent = `{{ 'Submitting...'|trans }}`;
            }

            supportApi.post(
                'support/ticket_reply',
                FOSSBilling.tools.serializeFormDataToObject(new FormData(ticketReplyForm)),
                () => {
                    flashMessage({
                        message: `{{ 'Reply posted successfully'|trans }}`,
                        reload: true
                    });
                },
                (res) => {
                    if (postReplyBtn) {
                        postReplyBtn.disabled = false;
                        postReplyBtn.textContent = `{{ 'Submit Response'|trans }}`;
                    }
                    FOSSBilling.message(`${res.message} (${res.code})`, 'error');
                }
            );
        });

        closeTicketBtn?.addEventListener('click', (e) => {
            e.preventDefault();
            if (confirm(`{{ 'Are you sure you want to close this ticket?'|trans }}`)) {
                closeTicketBtn.disabled = true;
                supportApi.post(
                    'support/ticket_close',
                    { id: {{ ticket.id }} },
                    () => {
                        flashMessage({
                            message: `{{ 'Ticket #%s closed'|trans|format(ticket.id) }}`,
                            reload: true
                        });
                    },
                    (res) => {
                        closeTicketBtn.disabled = false;
                        FOSSBilling.message(`${res.message} (${res.code})`, 'error');
                    }
                );
            }
        });

        replyToMessageBtns.forEach((btn) => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                let quote = btn.getAttribute('message-quote');
                if (!quote) return;
                quote = quote.replace(/^\s*$(?:\r\n?|\n)/gm, '');

                if (ticketReplyTextArea.editor) {
                    ticketReplyTextArea.editor.setData(quote + '\n\n');
                    ticketReplyTextArea.editor.focus();
                } else {
                    ticketReplyTextArea.value = quote + '\n\n' + ticketReplyTextArea.value;
                    ticketReplyTextArea.focus();
                }

                document.getElementById('reply-to')?.scrollIntoView({ behavior: 'smooth' });
            });
        });
    });
</script>
{% endblock %}
