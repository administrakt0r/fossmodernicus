{% extends "layout_default.html.twig" %}

{% block meta_title %}{{ 'Client Dashboard'|trans }}{% endblock %}

{% block content %}
    {{ render_widgets('client.index.dashboard.content.before') }}

    {% if client %}
        {{ render_widgets('client.index.dashboard.client.before') }}

        <!-- Welcome Banner -->
        <div class="theme-card mb-4" style="border-left: 4px solid var(--primary);">
            <div class="theme-card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h1 class="theme-page-title mb-1">
                        {{ settings.welcome_title|default('Welcome back'|trans) }}, {{ profile.first_name }}!
                    </h1>
                    <p class="text-muted mb-0" style="font-size: 0.9375rem;">
                        {{ settings.welcome_subtitle|default('Here is a summary of your active services, billing, and support requests.'|trans) }}
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="{{ 'order'|url }}" class="theme-btn theme-btn-primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        <span>{{ 'Order New Service'|trans }}</span>
                    </a>
                    <a href="{{ 'support'|url }}" class="theme-btn theme-btn-secondary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        <span>{{ 'New Ticket'|trans }}</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Metric Stat Cards -->
        {% if settings.show_metric_cards != '0' %}
        <div class="row g-3 mb-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
            <!-- Active Services -->
            <div class="theme-stat-card">
                <div class="theme-stat-icon primary">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
                </div>
                <div class="theme-stat-content">
                    <div class="theme-stat-label">{{ 'Active Services'|trans }}</div>
                    <div class="theme-stat-value">{{ dashboard.orders.active|default(0) }}</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">
                        <a href="{{ 'order/service'|url }}">{{ 'Manage services'|trans }} &rarr;</a>
                    </div>
                </div>
            </div>

            <!-- Unpaid Invoices -->
            <div class="theme-stat-card stat-warning">
                <div class="theme-stat-icon warning">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                </div>
                <div class="theme-stat-content">
                    <div class="theme-stat-label">{{ 'Unpaid Invoices'|trans }}</div>
                    <div class="theme-stat-value" style="color: var(--color-warning);">{{ dashboard.invoices.unpaid|default(0) }}</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">
                        <a href="{{ 'invoice'|url }}">{{ 'View billing'|trans }} &rarr;</a>
                    </div>
                </div>
            </div>

            <!-- Open Support Tickets -->
            <div class="theme-stat-card stat-info">
                <div class="theme-stat-icon info">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                </div>
                <div class="theme-stat-content">
                    <div class="theme-stat-label">{{ 'Open Tickets'|trans }}</div>
                    <div class="theme-stat-value" style="color: var(--color-info);">{{ dashboard.tickets.open|default(0) }}</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">
                        <a href="{{ 'support'|url }}">{{ 'View tickets'|trans }} &rarr;</a>
                    </div>
                </div>
            </div>

            <!-- Account Balance -->
            <div class="theme-stat-card stat-success">
                <div class="theme-stat-icon success">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                </div>
                <div class="theme-stat-content">
                    <div class="theme-stat-label">{{ 'Account Balance'|trans }}</div>
                    <div class="theme-stat-value" style="color: var(--color-success);">{{ profile.balance | format_currency(profile.currency ?? default_currency) }}</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">
                        <a href="{{ 'client/balance'|url }}">{{ 'Add funds'|trans }} &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Two Column Layout: Recent Orders & Recent Invoices -->
        <div class="row g-4 mb-4">
            <!-- Recent Services / Orders -->
            <div class="col-12 col-xl-6">
                <div class="theme-card mb-0 h-100 d-flex flex-column">
                    <div class="theme-card-header">
                        <h3 class="theme-card-title">{{ 'Active Services'|trans }}</h3>
                        <a href="{{ 'order/service'|url }}" class="theme-btn theme-btn-secondary theme-btn-sm">{{ 'View All'|trans }}</a>
                    </div>
                    <div class="theme-card-body p-0 flex-grow-1">
                        {% if dashboard.recent_orders and dashboard.recent_orders|length > 0 %}
                            <div class="table-responsive">
                                <table class="theme-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>{{ 'Service'|trans }}</th>
                                            <th>{{ 'Updated'|trans }}</th>
                                            <th>{{ 'Status'|trans }}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for order in dashboard.recent_orders %}
                                            <tr>
                                                <td>
                                                    <a href="{{ 'order/service/manage/' ~ order.id|url }}" style="font-weight: 600;">
                                                        {{ order.title }}
                                                    </a>
                                                    <div style="font-size: 0.75rem; color: var(--text-muted);">#{{ order.id }}</div>
                                                </td>
                                                <td style="font-size: 0.8125rem; color: var(--text-muted);">
                                                    {{ order.updated_at|timeago }} {{ 'ago'|trans }}
                                                </td>
                                                <td>
                                                    <span class="theme-badge theme-badge-{{ order.status == 'active' ? 'success' : (order.status == 'pending_setup' ? 'warning' : 'info') }}">
                                                        {{ order.status|capitalize }}
                                                    </span>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <div class="p-4 text-center text-muted">
                                <p class="mb-2">{{ 'You do not have any active services yet.'|trans }}</p>
                                <a href="{{ 'order'|url }}" class="theme-btn theme-btn-outline theme-btn-sm">{{ 'Browse Services'|trans }}</a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Recent Invoices -->
            <div class="col-12 col-xl-6">
                <div class="theme-card mb-0 h-100 d-flex flex-column">
                    <div class="theme-card-header">
                        <h3 class="theme-card-title">{{ 'Recent Invoices'|trans }}</h3>
                        <a href="{{ 'invoice'|url }}" class="theme-btn theme-btn-secondary theme-btn-sm">{{ 'View All'|trans }}</a>
                    </div>
                    <div class="theme-card-body p-0 flex-grow-1">
                        {% if dashboard.recent_invoices and dashboard.recent_invoices|length > 0 %}
                            <div class="table-responsive">
                                <table class="theme-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>{{ 'Invoice'|trans }}</th>
                                            <th>{{ 'Amount'|trans }}</th>
                                            <th>{{ 'Status'|trans }}</th>
                                            <th class="text-end">{{ 'Action'|trans }}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for invoice in dashboard.recent_invoices %}
                                            <tr>
                                                <td>
                                                    <a href="{{ 'invoice/' ~ invoice.hash|url }}" style="font-weight: 600;">
                                                        #{{ invoice.serie_nr|default(invoice.id) }}
                                                    </a>
                                                    <div style="font-size: 0.75rem; color: var(--text-muted);">{{ invoice.created_at|format_date }}</div>
                                                </td>
                                                <td style="font-weight: 600;">
                                                    {{ invoice.total | format_currency(invoice.currency ?? default_currency) }}
                                                </td>
                                                <td>
                                                    <span class="theme-badge theme-badge-{{ invoice.status == 'paid' ? 'success' : (invoice.status == 'unpaid' ? 'warning' : 'secondary') }}">
                                                        {{ invoice.status|capitalize }}
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    {% if invoice.status == 'unpaid' %}
                                                        <a href="{{ 'invoice/' ~ invoice.hash|url }}" class="theme-btn theme-btn-primary theme-btn-sm">{{ 'Pay Now'|trans }}</a>
                                                    {% else %}
                                                        <a href="{{ 'invoice/' ~ invoice.hash|url }}" class="theme-btn theme-btn-outline theme-btn-sm">{{ 'View'|trans }}</a>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <div class="p-4 text-center text-muted">
                                <p class="mb-0">{{ 'No invoices found.'|trans }}</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Support Tickets -->
        <div class="theme-card mb-4">
            <div class="theme-card-header">
                <h3 class="theme-card-title">{{ 'Recent Support Tickets'|trans }}</h3>
                <a href="{{ 'support'|url }}" class="theme-btn theme-btn-secondary theme-btn-sm">{{ 'All Tickets'|trans }}</a>
            </div>
            <div class="theme-card-body p-0">
                {% if dashboard.recent_tickets and dashboard.recent_tickets|length > 0 %}
                    <div class="table-responsive">
                        <table class="theme-table mb-0">
                            <thead>
                                <tr>
                                    <th>{{ 'Subject'|trans }}</th>
                                    <th>{{ 'Last Updated'|trans }}</th>
                                    <th>{{ 'Status'|trans }}</th>
                                    <th class="text-end">{{ 'Action'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for ticket in dashboard.recent_tickets %}
                                    <tr>
                                        <td>
                                            <a href="{{ 'support/ticket/' ~ ticket.id|url }}" style="font-weight: 600;">
                                                {{ ticket.subject }}
                                            </a>
                                            <div style="font-size: 0.75rem; color: var(--text-muted);">#{{ ticket.id }}</div>
                                        </td>
                                        <td style="font-size: 0.8125rem; color: var(--text-muted);">
                                            {{ ticket.updated_at|timeago }} {{ 'ago'|trans }}
                                        </td>
                                        <td>
                                            <span class="theme-badge theme-badge-{{ ticket.status == 'open' ? 'info' : (ticket.status == 'waiting_client' ? 'warning' : 'secondary') }}">
                                                {{ ticket.status|replace({'_': ' '})|capitalize }}
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a href="{{ 'support/ticket/' ~ ticket.id|url }}" class="theme-btn theme-btn-outline theme-btn-sm">{{ 'View'|trans }}</a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="p-4 text-center text-muted">
                        <p class="mb-2">{{ 'You have no open support tickets.'|trans }}</p>
                        <a href="{{ 'support'|url }}" class="theme-btn theme-btn-outline theme-btn-sm">{{ 'Open a Ticket'|trans }}</a>
                    </div>
                {% endif %}
            </div>
        </div>

        {{ render_widgets('client.index.dashboard.client.after', { 'dashboard': dashboard, 'profile': profile }) }}
    {% else %}
        {{ render_widgets('client.index.dashboard.guest.before') }}

        {% set cart_currency = guest.cart_get_currency %}
        {% set categories = guest.product_category_get_list.list %}

        <!-- Guest Hero Section -->
        <section class="front-hero mb-5">
            <h1 class="display-5 fw-bold text-main mb-3" style="max-width: 820px; margin-left: auto; margin-right: auto;">
                {{ settings.front_hero_title|default(company.name|default('Welcome to our Client Portal'|trans)) }}
            </h1>
            <p class="text-muted fs-5 mb-4" style="max-width: 680px; margin-left: auto; margin-right: auto;">
                {{ settings.front_hero_subtitle|default('Browse our services, manage existing subscriptions, pay invoices, and access customer support.'|trans) }}
            </p>

            <!-- Call to Action Buttons -->
            <div class="d-flex flex-wrap justify-content-center gap-3 mt-4 pt-2">
                <a href="{{ 'order'|url }}" class="theme-btn theme-btn-primary py-2 px-4 fs-6">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                    <span>{{ 'Browse All Services'|trans }}</span>
                </a>
                <a href="{{ 'login'|url }}" class="theme-btn theme-btn-secondary py-2 px-4 fs-6">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                    <span>{{ 'Client Portal Login'|trans }}</span>
                </a>
                {% if settings.show_register_link != '0' %}
                    <a href="{{ 'signup'|url }}" class="theme-btn theme-btn-outline py-2 px-4 fs-6">
                        <span>{{ 'Create Account'|trans }}</span>
                    </a>
                {% endif %}
            </div>
        </section>

        <!-- Optional Admin-Configured Feature Highlights -->
        {% if settings.show_front_features == '1' %}
            {% set active_features = [] %}
            {% for i in 1..4 %}
                {% set f_title = attribute(settings, 'front_feature_' ~ i ~ '_title') %}
                {% set f_desc = attribute(settings, 'front_feature_' ~ i ~ '_desc') %}
                {% if f_title is not empty %}
                    {% set active_features = active_features|merge([{ 'title': f_title, 'desc': f_desc }]) %}
                {% endif %}
            {% endfor %}
            {% if active_features is not empty %}
                <section class="mb-5">
                    <div class="row g-4">
                        {% for feat in active_features %}
                            <div class="col-12 col-sm-6 col-lg-{{ (12 / active_features|length)|round(0, 'floor') }}">
                                <div class="front-feature-card">
                                    <div class="front-feature-icon">
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                    </div>
                                    <h3 class="h5 fw-bold text-main mb-2">{{ feat.title }}</h3>
                                    {% if feat.desc is not empty %}
                                        <p class="text-muted small mb-0">{{ feat.desc }}</p>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}
        {% endif %}

        <!-- Featured Products Showcase -->
        {% if categories is not empty %}
            <section class="mb-5">
                <div class="text-center mb-4">
                    <h2 class="h3 fw-bold text-main mb-1">{{ settings.front_products_title|default('Featured Products & Services'|trans) }}</h2>
                    <p class="text-muted small mb-0">{{ settings.front_products_subtitle|default('Browse our available products and solutions.'|trans) }}</p>
                </div>

                <div class="row g-4">
                    {% set displayed_count = 0 %}
                    {% for cat in categories %}
                        {% for product in cat.products|sort((a, b) => a.priority <=> b.priority) %}
                            {% if displayed_count < 3 and product.status == 'enabled' and product.type != 'domain' %}
                                {% set displayed_count = displayed_count + 1 %}
                                <div class="col-12 col-md-6 col-lg-4 d-flex">
                                    <div class="theme-card theme-product-card d-flex flex-column w-100">
                                        <div class="product-card-header p-4 pb-3">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="badge bg-primary-lt fw-medium">{{ cat.title }}</span>
                                            </div>
                                            <h3 class="product-title h4 fw-bold mb-2">{{ product.title }}</h3>
                                            <div class="product-description text-muted small">
                                                {{ (product.description ?? '')|markdown_to_html }}
                                            </div>
                                        </div>

                                        <div class="product-card-pricing p-4 border-top border-bottom border-subtle mt-auto">
                                            <div class="small text-muted mb-1">{{ 'Starting at'|trans }}</div>
                                            <div class="d-flex align-items-baseline gap-1">
                                                {% if product.pricing.type == 'recurrent' %}
                                                    {% for code, prices in product.pricing.recurrent %}
                                                        {% if loop.first %}
                                                            <span class="display-6 fw-bold text-main font-monospace">
                                                                {{ (prices.price * cart_currency.conversion_rate)|format_currency(cart_currency.code ?? default_currency) }}
                                                            </span>
                                                            <span class="text-muted small">/ {{ guest.system_periods[code]|default(code)|trans }}</span>
                                                        {% endif %}
                                                    {% endfor %}
                                                {% elseif product.pricing.type == 'once' %}
                                                    <span class="display-6 fw-bold text-main font-monospace">
                                                        {{ (product.pricing.once.price * cart_currency.conversion_rate)|format_currency(cart_currency.code ?? default_currency) }}
                                                    </span>
                                                    <span class="text-muted small">/ {{ 'one-time'|trans }}</span>
                                                {% else %}
                                                    <span class="display-6 fw-bold text-success font-monospace">{{ 'Free'|trans }}</span>
                                                {% endif %}
                                            </div>
                                        </div>

                                        <div class="product-card-footer p-4 pt-3">
                                            <a href="{{ 'order'|url({ product: product.id }) }}" class="theme-btn theme-btn-primary w-100 justify-content-center py-2">
                                                <span>{{ 'Order Now'|trans }}</span>
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ms-1"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        <!-- Quick Help & Client Portal Gateway -->
        <section class="mb-4">
            <div class="row g-4">
                <div class="col-12 col-md-4">
                    <div class="theme-card p-4 h-100 d-flex flex-column justify-content-between">
                        <div>
                            <h3 class="h5 fw-bold text-main mb-2">{{ 'Client Dashboard'|trans }}</h3>
                            <p class="text-muted small mb-3">{{ 'Manage your active services, view invoices, and update account settings.'|trans }}</p>
                        </div>
                        <a href="{{ 'login'|url }}" class="theme-btn theme-btn-secondary theme-btn-sm align-self-start">
                            <span>{{ 'Sign In to Portal'|trans }} &rarr;</span>
                        </a>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="theme-card p-4 h-100 d-flex flex-column justify-content-between">
                        <div>
                            <h3 class="h5 fw-bold text-main mb-2">{{ 'Knowledgebase'|trans }}</h3>
                            <p class="text-muted small mb-3">{{ 'Explore our library of helpful articles, setup guides, and documentation.'|trans }}</p>
                        </div>
                        <a href="{{ 'support/kb'|url }}" class="theme-btn theme-btn-secondary theme-btn-sm align-self-start">
                            <span>{{ 'Read Articles'|trans }} &rarr;</span>
                        </a>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="theme-card p-4 h-100 d-flex flex-column justify-content-between">
                        <div>
                            <h3 class="h5 fw-bold text-main mb-2">{{ 'Contact Support'|trans }}</h3>
                            <p class="text-muted small mb-3">{{ 'Have questions or need assistance? Open a support ticket with our team.'|trans }}</p>
                        </div>
                        <a href="{{ 'support'|url }}" class="theme-btn theme-btn-secondary theme-btn-sm align-self-start">
                            <span>{{ 'Submit Ticket'|trans }} &rarr;</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        {{ render_widgets('client.index.dashboard.guest.after') }}
    {% endif %}

    {{ render_widgets('client.index.dashboard.content.after') }}
{% endblock %}
