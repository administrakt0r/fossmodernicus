{% set light_logo = settings.custom_logo_url|default(guest.system_company.logo_url|default(company.logo_url|default('img/logo.svg'|asset_url))) %}
{% set dark_logo = settings.custom_logo_dark_url|default('img/logo-dark.svg'|asset_url) %}
{% set link_url = link_url|default('/'|url) %}
{% set link_class = link_class|default('d-inline-flex align-items-center text-decoration-none') %}
{% set link_rel = link_rel|default(null) %}
{% set image_class = image_class|default('theme-brand-logo') %}
{% set image_height = image_height|default('40px') %}
{% set show_mobile_name = show_mobile_name|default(false) %}

<a{% if link_class %} class="{{ link_class }}"{% endif %} href="{{ link_url }}"{% if link_target is defined %} target="{{ link_target }}"{% endif %}{% if link_rel %} rel="{{ link_rel }}"{% endif %}>
    <img class="{{ image_class }} theme-logo-light" src="{{ light_logo }}" alt="{{ company.name|default('Client Portal') }}" width="160" height="{{ image_height }}" decoding="async" style="height: {{ image_height }}; width: auto; max-width: 100%;">
    <img class="{{ image_class }} theme-logo-dark" src="{{ dark_logo }}" alt="{{ company.name|default('Client Portal') }}" width="160" height="{{ image_height }}" decoding="async" style="height: {{ image_height }}; width: auto; max-width: 100%;">
    {% if show_mobile_name %}
        <span class="d-sm-none ms-2 fw-bold text-main">{{ company.name|default('Client Portal') }}</span>
    {% endif %}
</a>
