{% extends "layout_public.html.twig" %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ 'Reset Password'|trans }}{% endblock %}

{% block content %}
<div class="text-center mb-4">
    <h1 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 0.35rem; color: var(--text-main);">
        {{ 'Reset Your Password'|trans }}
    </h1>
    <p class="text-muted mb-0" style="font-size: 0.875rem;">
        {{ 'Enter your email address to receive instructions on how to reset your password.'|trans }}
    </p>
</div>

<form method="post" action="{{ 'client/reset_password'|api_url(null, 'guest') }}" {{ fb_api_form({message: 'A password reset confirmation email will be sent to you if an account exists for that address.'|trans}) }}>
    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">
    <div class="theme-form-group">
        <label class="theme-form-label" for="reset_email">{{ 'Email Address'|trans }}</label>
        <input type="email" class="theme-input" id="reset_email" name="email" value="{{ request.email }}" placeholder="you@domain.com" required autofocus>
    </div>

    {{ mf.recaptcha }}

    <div class="mt-4">
        <button type="submit" class="theme-btn theme-btn-primary w-100" style="padding: 0.65rem 1rem; font-size: 0.9375rem; width: 100%;">
            {{ 'Send Reset Link'|trans }}
        </button>
    </div>
</form>

<div class="text-center mt-4 pt-3 border-top border-subtle" style="font-size: 0.875rem;">
    <a href="{{ 'login'|url }}" style="font-weight: 600;">&larr; {{ 'Back to Sign In'|trans }}</a>
</div>
{% endblock %}
