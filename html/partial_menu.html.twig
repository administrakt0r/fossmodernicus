{% set current_active_menu = active_menu|default('') %}
{% set current_page_name = current_page|default('') %}

<div class="theme-card p-2">
    <nav class="nav flex-column">
        <a class="theme-nav-link {% if current_active_menu == 'dashboard' or (current_active_menu == '' and (current_page_name == 'index' or current_page_name == '')) %}active{% endif %}" href="{{ '/'|url }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span>{{ 'Dashboard'|trans }}</span>
        </a>
        <a class="theme-nav-link {% if current_active_menu == 'services' or 'service' in current_page_name %}active{% endif %}" href="{{ 'order/service'|url }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/></svg>
            <span>{{ 'Services'|trans }}</span>
        </a>
        <a class="theme-nav-link {% if current_active_menu == 'invoices' or 'invoice' in current_page_name %}active{% endif %}" href="{{ 'invoice'|url }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/></svg>
            <span>{{ 'Invoices'|trans }}</span>
        </a>
        <a class="theme-nav-link {% if current_active_menu == 'support' or 'support' in current_page_name %}active{% endif %}" href="{{ 'support'|url }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <span>{{ 'Support'|trans }}</span>
        </a>
        <a class="theme-nav-link {% if current_active_menu == 'order' or 'order' in current_page_name %}active{% endif %}" href="{{ 'order'|url }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            <span>{{ 'Order'|trans }}</span>
        </a>
        <a class="theme-nav-link {% if current_active_menu == 'profile' or 'profile' in current_page_name %}active{% endif %}" href="{{ 'client/profile'|url }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span>{{ 'Profile'|trans }}</span>
        </a>
    </nav>
</div>
