{% extends "layout_default.html.twig" %}

{% block meta_title %}{{ 'Error'|trans }} {{ exception.getCode|default('404') }}{% endblock %}

{% block content %}
<div class="theme-card text-center py-5 my-4">
    <div class="theme-card-body">
        <div style="font-size: 4rem; font-weight: 800; color: var(--primary); line-height: 1; margin-bottom: 1rem;">
            {{ exception.getCode|default('404') }}
        </div>
        <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-main);">
            {{ 'Oops! Something went wrong'|trans }}
        </h2>
        <p class="text-muted mb-4" style="max-width: 500px; margin-left: auto; margin-right: auto;">
            {{ exception.getMessage|default('The requested page could not be found or an unexpected error occurred.'|trans) }}
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a href="{{ '/'|url }}" class="theme-btn theme-btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                <span>{{ 'Return to Dashboard'|trans }}</span>
            </a>
            <a href="{{ 'support'|url }}" class="theme-btn theme-btn-secondary">
                <span>{{ 'Contact Support'|trans }}</span>
            </a>
        </div>
    </div>
</div>
{% endblock %}
