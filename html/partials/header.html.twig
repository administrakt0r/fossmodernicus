<header class="theme-header">
    {{ render_widgets('client.theme.header.start') }}
    <div class="theme-header-left">
        <button type="button" class="theme-mobile-toggle" id="theme-mobile-toggle" aria-label="{{ 'Toggle navigation'|trans }}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>

        {% if settings.show_breadcrumbs != '0' %}
            <nav class="theme-breadcrumbs d-none d-md-flex" aria-label="breadcrumb">
                <a href="{{ '/'|url }}">{{ 'Home'|trans }}</a>
                <span>/</span>
                <span>{% block breadcrumb_item %}{{ 'Dashboard'|trans }}{% endblock %}</span>
            </nav>
        {% endif %}
    </div>

    <div class="theme-header-right">
        {% if client and settings.show_client_balance != '0' %}
            <div class="theme-balance-pill d-none d-sm-inline-flex">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                <span>{{ profile.balance | format_currency(profile.currency ?? default_currency) }}</span>
            </div>
        {% endif %}

        {% if settings.show_theme_toggle != '0' %}
            <button type="button" class="theme-toggle-btn" id="theme-toggle-btn" title="{{ 'Switch theme mode'|trans }}" aria-label="{{ 'Switch theme mode'|trans }}">
                <span class="theme-toggle-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                </span>
            </button>
        {% endif %}

        {% if client %}
            <div class="theme-user-menu">
                <button type="button" class="theme-toggle-btn" id="theme-user-dropdown-btn" aria-label="{{ 'User profile menu'|trans }}" aria-haspopup="true" style="border: none; background: transparent; padding: 0;">
                    <div class="theme-avatar">
                        {{ profile.first_name|first|upper }}{{ profile.last_name|first|upper }}
                    </div>
                </button>
                <div id="theme-user-dropdown-menu" class="theme-card d-none position-absolute end-0 mt-2 p-2 shadow-lg" style="width: 220px; z-index: 1050; border-radius: var(--radius-md);">
                    <div class="px-3 py-2 border-bottom border-subtle">
                        <div style="font-weight: 600; font-size: 0.875rem;">{{ profile.first_name }} {{ profile.last_name }}</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted); word-break: break-all;">{{ profile.email }}</div>
                    </div>
                    <a href="{{ 'client/profile'|url }}" class="theme-nav-link mt-1">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        <span>{{ 'Profile'|trans }}</span>
                    </a>
                    <a href="{{ 'invoice'|url }}" class="theme-nav-link">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                        <span>{{ 'Billing'|trans }}</span>
                    </a>
                    <hr style="margin: 0.5rem 0; border: none; border-top: 1px solid var(--border-subtle);">
                    <a href="{{ 'client/logout'|url }}" class="theme-nav-link text-danger">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        <span>{{ 'Sign Out'|trans }}</span>
                    </a>
                </div>
            </div>
        {% else %}
            <a href="{{ 'login'|url }}" class="theme-btn theme-btn-outline theme-btn-sm">{{ 'Log In'|trans }}</a>
            {% if settings.show_register_link != '0' %}
                <a href="{{ 'signup'|url }}" class="theme-btn theme-btn-primary theme-btn-sm">{{ 'Register'|trans }}</a>
            {% endif %}
        {% endif %}
    </div>
    {{ render_widgets('client.theme.header.end') }}
</header>
